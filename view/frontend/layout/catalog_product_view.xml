<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The lm.js block names the page's product with cw.push(['context', ...]). -->
        <referenceBlock name="cwax.lastmile">
            <arguments>
                <argument name="product_view" xsi:type="object">Cwax\Banner\ViewModel\ProductView</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="cwax.product.view"
                   template="Cwax_Banner::product-view.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Cwax\Banner\ViewModel\ProductView</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
