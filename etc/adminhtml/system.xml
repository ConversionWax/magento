<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="conversionwax" translate="label" sortOrder="420">
            <label>ConversionWax</label>
        </tab>
        <section id="conversionwax_lastmile"
                 translate="label"
                 type="text"
                 sortOrder="10"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Last Mile</label>
            <tab>conversionwax</tab>
            <resource>Cwax_Banner::lastmile_config</resource>
            <group id="connection"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Server Event Connection</label>
                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Events are added to Magento's queue during storefront requests. Network delivery runs only in the queue consumer.</comment>
                </field>
                <field id="web_property_id"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>ConversionWax Website ID</label>
                    <validate>required-entry</validate>
                    <comment>Copy the Website ID from Last Mile tracking settings in ConversionWax.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="respect_cookie_restriction"
                       translate="label comment"
                       type="select"
                       sortOrder="15"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Respect Magento Cookie Restriction</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, no Last Mile event or visitor cookie is created until Magento says the visitor may use cookies.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="api_token"
                       translate="label comment"
                       type="obscure"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Connection Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Generate this one-time token in ConversionWax. Magento stores it encrypted.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="endpoint"
                       translate="label comment"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Collector Endpoint</label>
                    <validate>required-entry validate-url</validate>
                    <comment>Use https://dev.collect.conversionwax.com/v1/integrations/magento/events for staging.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
