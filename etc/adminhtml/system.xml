<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="conversionwax" translate="label" sortOrder="420">
            <label>ConversionWax</label>
        </tab>
        <section id="conversionwax_lastmile"
                 translate="label"
                 type="text"
                 sortOrder="10"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Last Mile</label>
            <tab>conversionwax</tab>
            <resource>Cwax_Banner::lastmile_config</resource>
            <group id="connection"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Server Event Connection</label>
                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Events are added to Magento's queue during storefront requests. Network delivery runs only in the queue consumer.</comment>
                </field>
                <field id="web_property_id"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>ConversionWax Website ID</label>
                    <validate>required-entry validate-length minimum-length-36 maximum-length-36</validate>
                    <comment>Copy the 36-character Website ID from Last Mile tracking settings in ConversionWax. A value of the wrong length is rejected at save time; this catches a truncated or partial paste, but it cannot confirm the ID matches the intended website.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="api_token"
                       translate="label comment"
                       type="obscure"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Connection Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Generate this one-time token in ConversionWax. Magento stores it encrypted.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="endpoint"
                       translate="label comment"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Collector Endpoint</label>
                    <validate>required-entry validate-url</validate>
                    <comment>Use https://dev.collect.conversionwax.com/v1/integrations/magento/events for staging.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="consent"
                   translate="label"
                   type="text"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Consent</label>
                <field id="snippet_installed"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Browser Snippet Installed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set to No for a server-only integration with no ConversionWax browser snippet on this store. Under Wait for Consent mode the server has no other way to learn that consent was granted, so this store falls back to the policy below instead of waiting for a cookie that can never appear.</comment>
                </field>
                <field id="fallback_policy"
                       translate="label comment"
                       type="select"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Server-Only Fallback Policy</label>
                    <source_model>Cwax\Banner\Model\Config\Source\ConsentFallbackPolicy</source_model>
                    <comment>Applies only when this store's consent mode cannot be resolved from ConversionWax at all, or when Browser Snippet Installed above is No and the resolved mode is Wait for Consent. Does not apply when the mode is known and a snippet is installed.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
