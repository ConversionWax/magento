<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Luma checkout places the order through REST (payment-information) and REST/GraphQL clients add to
         cart. Without this flush a visitor Magento mints there (lm.js blocked) never gets _cwid, and an
         existing _cwid is not refreshed. -->
    <event name="controller_front_send_response_before">
        <observer name="conversionwax_lastmile_identity_flush"
                  instance="Cwax\Banner\Observer\Lastmile\IdentityFlushObserver"/>
    </event>
</config>
