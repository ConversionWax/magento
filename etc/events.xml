<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_submit_all_after">
        <observer name="conversionwax_lastmile_purchase"
                  instance="Cwax\Banner\Observer\Lastmile\PurchaseObserver"/>
    </event>
    <!-- Refunds and cancels: global, because they happen in the admin, in REST calls and in cron. -->
    <event name="sales_order_creditmemo_refund">
        <observer name="conversionwax_lastmile_refund_mark"
                  instance="Cwax\Banner\Observer\Lastmile\CreditmemoRefundObserver"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="conversionwax_lastmile_refund"
                  instance="Cwax\Banner\Observer\Lastmile\CreditmemoSaveObserver"/>
    </event>
    <event name="order_cancel_after">
        <observer name="conversionwax_lastmile_cancel"
                  instance="Cwax\Banner\Observer\Lastmile\OrderCancelObserver"/>
    </event>
    <event name="sales_quote_product_add_after">
        <observer name="conversionwax_lastmile_add_to_cart"
                  instance="Cwax\Banner\Observer\Lastmile\AddToCartObserver"/>
    </event>
</config>
