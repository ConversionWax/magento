<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_front_send_response_before">
        <observer name="conversionwax_lastmile_identity_flush"
                  instance="Cwax\Banner\Observer\Lastmile\IdentityFlushObserver"/>
    </event>
    <event name="customer_login">
        <observer name="conversionwax_lastmile_customer_login"
                  instance="Cwax\Banner\Observer\Lastmile\IdentifyObserver"/>
    </event>
    <event name="customer_register_success">
        <observer name="conversionwax_lastmile_customer_register"
                  instance="Cwax\Banner\Observer\Lastmile\IdentifyObserver"/>
    </event>
    <!-- Guest checkout email (Hyva Checkout, other one page checkouts) and newsletter signup. Storefront
         only: an admin order or an admin subscriber edit has no visitor of its own. -->
    <event name="sales_quote_save_after">
        <observer name="conversionwax_lastmile_guest_quote_email"
                  instance="Cwax\Banner\Observer\Lastmile\GuestQuoteEmailObserver"/>
    </event>
    <event name="newsletter_subscriber_save_after">
        <observer name="conversionwax_lastmile_newsletter_signup"
                  instance="Cwax\Banner\Observer\Lastmile\NewsletterSubscriberObserver"/>
    </event>
</config>
