<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_front_send_response_before">
        <observer name="conversionwax_lastmile_page_view"
                  instance="Cwax\Banner\Observer\Lastmile\PageViewObserver"/>
    </event>
    <event name="catalog_controller_product_view">
        <observer name="conversionwax_lastmile_product_view"
                  instance="Cwax\Banner\Observer\Lastmile\ProductViewObserver"/>
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="conversionwax_lastmile_checkout_start"
                  instance="Cwax\Banner\Observer\Lastmile\CheckoutStartObserver"/>
    </event>
    <event name="customer_login">
        <observer name="conversionwax_lastmile_customer_login"
                  instance="Cwax\Banner\Observer\Lastmile\IdentifyObserver"/>
    </event>
    <event name="customer_register_success">
        <observer name="conversionwax_lastmile_customer_register"
                  instance="Cwax\Banner\Observer\Lastmile\IdentifyObserver"/>
    </event>
</config>
